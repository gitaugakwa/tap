{
  "name": "tap",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test packages",
    "check": "bun run lint && bun run typecheck && bun run test",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "bun-types": "1.4.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
