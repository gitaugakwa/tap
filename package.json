{
  "name": "tap",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "arch": "bun run scripts/check-architecture.ts",
    "lint": "biome check .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test packages",
    "test:contracts": "cd contracts && forge test",
    "check": "bun run arch && bun run lint && bun run typecheck && bun run test && bun run test:contracts",
    "hooks:install": "git config core.hooksPath .githooks",
    "postinstall": "bun run --cwd=\"$(pwd)/node_modules/react-native-hce\" build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "bun-types": "1.4.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
